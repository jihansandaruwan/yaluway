<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Yaluway" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/yalu_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/yalu_yellow</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/yalu_background</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Yaluway" parent="Base.Theme.Yaluway" />

    <style name="YaluPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/yalu_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="YaluFieldLabel">
        <item name="android:textColor">@color/yalu_navy</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
